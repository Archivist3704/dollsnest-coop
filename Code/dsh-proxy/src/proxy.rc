// dsh-proxy/proxy.rc -- identity for the proxy DLL.
//
// WHY: an unsigned DLL with NO version resource at all is the shape of a packer's output. Every
// legitimate shim in a game folder carries a product name and a file version, and a scanner that
// ranks by "does this file say what it is" ranks a blank one worse. This costs nothing and it is
// also what Windows shows in the file's Properties dialog, which is where a player looks first.
//
// ASCII-only by project rule.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "dollsnest-coop"
            VALUE "FileDescription", "Dolls Nest co-op: loads dollsnest-coop.dll (forwarder for version.dll)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "version"
            VALUE "LegalCopyright", "dollsnest-coop"
            VALUE "OriginalFilename", "version.dll"
            VALUE "ProductName", "Dolls Nest co-op"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
